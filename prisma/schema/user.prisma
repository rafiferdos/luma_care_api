model User {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  password           String? // nullable — Google-only patient has none until they set one
  profileImage       String?
  authProvider       AuthProvider @default(CREDENTIALS)
  googleId           String?      @unique
  role               UserRole
  status             UserStatus   @default(ACTIVE)
  isDeleted          Boolean      @default(false)
  isEmailVerified    Boolean      @default(false)
  mustChangePassword Boolean      @default(false) // forced after Admin/Super Admin creation

  patient Patient?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}
